# 上游源码（按 README 的 git clone 获取）与编译产物
/vendor/esp32sim/
/src-tauri/target/
/src-tauri/gen/

# sidecar 二进制由 scripts/build-sidecar.ps1 生成
/src-tauri/binaries/*.exe

# 由 scripts/stage-web.cjs 生成
/resources/web/

# 构建与运行产物
/dist/
/out/
node_modules/
/.wv2-diag/

# 示例固件的编译产物（几百 MB 的中间文件）与导出的画面预览
/firmware/*/build/
/firmware/*/preview.png

# 验收过程日志与中间产物（正式记录见 docs/ACCEPTANCE.md）
/docs/*.log
/docs/acceptance-*.json
/testdata/build/

# 被修正版截图取代的早期截图
/docs/p0-app.png

# 编辑器与系统文件
Thumbs.db
Desktop.ini
*.tmp
/.workbuddy/

# ── 不对外发布：开发过程、本机绝对路径、个人与设备信息 ──────────────
# 开发计划与执行记录（含项目目录绝对路径、阶段验收数据）
/PLAN.md
# 文档与验收记录（含 E:\ 绝对路径、截图、本机环境）
/docs/
# 补丁统一用 git diff 导出（无邮件头/作者信息）；format-patch 的 mbox 不发布
/patches/*.mbox
# Espressif mask ROM，不随仓库分发
/roms/
# 验收 / 诊断脚本硬编码了本机绝对路径
/scripts/acceptance*.cjs
/scripts/verify-*.cjs
/scripts/diag-*.cjs
/scripts/diagnose-*.cjs
