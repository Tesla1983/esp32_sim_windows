+/// which is exactly the prefix that sends IDF down this path, so the two agree.
+///
+/// Layout follows JESD216: "SFDP" signature, revision, one parameter header pointing at 0x30,
+/// then the basic flash parameter table. Bytes outside 0x00-0x33 read as 0, which is what a real
+/// part returns for an unimplemented parameter area.
+pub fn sfdp_byte(addr: u32) -> u8 {
+    const TABLE: [u8; 0x34] = {
+        let mut t = [0u8; 0x34];
+        t[0] = b'S'; t[1] = b'F'; t[2] = b'D'; t[3] = b'P';
+        t[4] = 0x06;                    // minor revision
+        t[5] = 0x01;                    // major revision
+        t[6] = 0x01;                    // one parameter header
+        t[7] = 0xFF;                    // access protocol: legacy SPI
+        t[8] = 0x00;                    // header 0: parameter ID 0 (basic flash parameter table)
+        t[9] = 0x05;                    // minor revision 5
+        t[10] = 0x01;                   // major revision 1
+        t[11] = 0x10;                   // table length, 16 DWORDs
+        t[12] = 0x30;                   // table pointer 0x000030
+        t[15] = 0xFF;
+        t[0x30] = 0xE5;                 // BFPT DWORD0
+        t[0x31] = 0x20;
+        t[0x32] = 0x08;                 // bit 3: suspend/resume supported (the probe above)
+        t
+    };
+    TABLE.get(addr as usize).copied().unwrap_or(0)
