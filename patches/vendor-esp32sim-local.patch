+    #[test]
+    fn qspi_panel_only_hears_its_own_wires() {
+        let specs = vec![DeviceSpec::parse("2:368:448:16:11:12:co5300").unwrap()];
+        let mut board = ConfigurableBoard::new(specs);
+        // A pinned panel opts in to route decoding, like a pin-bound I2C device.
+        assert!(board.uses_spi_pins());
+
+        let ramwr = [0x02u8, 0x00, 0x2c, 0x00];
+        let wired = SpiPins { sclk: 1 << 11, cs: 1 << 12, ..Default::default() };
+        board.spi_transfer_pins(2, wired, &ramwr, 0);
+        assert_eq!(board.display_frames(), 1, "SCLK 11 + CS 12 is the panel's own pair");
+
+        // Same host, but the clock is routed to another pad: nothing reaches the panel.
+        let wrong_sclk = SpiPins { sclk: 1 << 4, cs: 1 << 12, ..Default::default() };
+        board.spi_transfer_pins(2, wrong_sclk, &ramwr, 0);
+        assert_eq!(board.display_frames(), 1, "a different clock pin leaves the panel silent");
+
+        // Chip select never asserted (route has no CS pin) is the same story.
+        let no_cs = SpiPins { sclk: 1 << 11, cs: 0, ..Default::default() };
+        board.spi_transfer_pins(2, no_cs, &ramwr, 0);
+        assert_eq!(board.display_frames(), 1, "no asserted chip select means no transaction");
+
+        // The route-less callback must not bypass the wiring either.
+        board.spi_transfer(2, &ramwr, 0);
+        assert_eq!(board.display_frames(), 1, "the pin-less path cannot reach a pinned panel");
+    }
